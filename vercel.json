{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": ".",
      "framework": "vite",
      "rewrites": [
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ]
    },
    "mcp": {
      "root": "mcp",
      "entrypoint": "vercel_app:app",
      "bindings": [
        {
          "type": "service",
          "service": "dxkp",
          "format": "url",
          "env": "DXKP_URL"
        }
      ]
    },
    "dxkp": {
      "root": "api",
      "entrypoint": "dxkp:app"
    },
    "admin": {
      "root": "backend",
      "framework": "vite"
    }
  },
  "headers": [
    {
      "source": "/admin/mockServiceWorker.js",
      "headers": [
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/glm-api/(.*)",
      "destination": "https://www.sophnet.com/api/open-apis/$1"
    },
    {
      "source": "/siliconflow-api/(.*)",
      "destination": "https://api.siliconflow.cn/$1"
    },
    {
      "source": "/tokendance-api/(.*)",
      "destination": "https://tokendance.space/$1"
    },
    {
      "source": "/openai-next-api/(.*)",
      "destination": "https://api.openai-next.com/$1"
    },
    {
      "source": "/mcp",
      "destination": {
        "service": "mcp"
      }
    },
    {
      "source": "/mcp/(.*)",
      "destination": {
        "service": "mcp"
      }
    },
    {
      "source": "/api/mcp",
      "destination": {
        "service": "mcp"
      }
    },
    {
      "source": "/api/mcp/(.*)",
      "destination": {
        "service": "mcp"
      }
    },
    {
      "source": "/dxkp-api/(.*)",
      "destination": {
        "service": "dxkp"
      }
    },
    {
      "source": "/api/dxkp/(.*)",
      "destination": {
        "service": "dxkp"
      }
    },
    {
      "source": "/admin",
      "destination": {
        "service": "admin",
        "path": "/"
      }
    },
    {
      "source": "/admin/(.*)",
      "destination": {
        "service": "admin",
        "path": "/$1"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}